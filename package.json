{
  "name": "floodnet",
  "version": "0.1.0",
  "private": true,
  "description": "FloodNet cloud-based flood reporting, early warning and evacuation coordination system",
  "workspaces": [
    "client",
    "microservices/evidence-service"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "npm run dev --workspace client",
    "prestart": "npm run build",
    "start": "node server/server.js",
    "build": "npm run build --workspace client",
    "db:migrate": "node server/db/run-migrations.js",
    "db:seed": "node server/db/run-seeds.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.823.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
