NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=floodnet
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false

# Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-another-long-random-value

# Browser/API configuration
CLIENT_ORIGIN=http://localhost:5173

# Task 1 evidence storage (Express uploads to this private S3 bucket)
AWS_REGION=us-east-1
EVIDENCE_BUCKET_NAME=
# Use s3 for the deployed Task 1 application. Use mock only for local tests.
EVIDENCE_STORAGE_MODE=s3
EVIDENCE_URL_EXPIRES_SECONDS=300

# Used only when switching the evidence upload path to Task 2
EVIDENCE_UPLOAD_SECRET=replace-with-a-long-random-value
VITE_EVIDENCE_ENABLED=true
VITE_TASK2_EVIDENCE_ENABLED=false
VITE_EVIDENCE_API_URL=

# River and rainfall conditions (Open-Meteo, no API key required).
# disabled = feature off and the application behaves as if it did not exist
# mock     = deterministic values, used by the tests and offline development
# live     = calls Open-Meteo. Requires outbound HTTPS from the server.
WEATHER_MODE=disabled
WEATHER_CACHE_TTL_SECONDS=3600
WEATHER_TIMEOUT_MS=4000

# Demo/development seed accounts (leave blank to skip the demo seed)
# Local demonstration seed only; leave blank in production.
# Quote the value. An unquoted "#" starts an inline comment and would silently
# truncate the password. The seed refuses to run if it is too weak.
DEMO_PASSWORD=
