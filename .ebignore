# Elastic Beanstalk deployment bundle contents.
#
# When this file is present the EB CLI uses it INSTEAD of .gitignore to decide
# what to upload. client/dist is intentionally not excluded here: the React
# production build is created locally with "npm run build" and shipped in the
# bundle, because the EB instance installs production dependencies only and
# therefore cannot run Vite itself.

node_modules/
.git/
.env
.env.*
!.env.example
coverage/
npm-debug.log*
.elasticbeanstalk/
eb-cli-output.log
.vscode/
.idea/
docs/
